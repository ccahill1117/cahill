{
  "name": "cahill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "scan-library": "aws lambda invoke --function-name cahill-library-scanner --region us-west-2 --invocation-type Event /tmp/scan-out.json && echo 'Scan triggered — library.json ready in ~30s'",
    "deploy-lambda": "bash scripts/deploy-lambda.sh",
    "deploy-cloudfront": "bash scripts/deploy-cloudfront.sh"
  },
  "dependencies": {
    "@types/three": "^0.184.1",
    "howler": "^2.2.4",
    "pinia": "^3.0.4",
    "three": "^0.184.0",
    "video.js": "^8.23.7",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "music-metadata": "^11.12.3",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
